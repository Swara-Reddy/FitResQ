# ==========================================
# FitResQ Environment Variables Template
# Copy this file to .env and fill in your values
# ==========================================

# ------------------------------------------
# Server & API Configuration
# ------------------------------------------
PORT=8000
HOST=0.0.0.0
AWS_REGION=us-east-1

# ------------------------------------------
# Frontend Environment Variables (Vite)
# ------------------------------------------
VITE_API_BASE_URL=https://your-api-gateway-id.execute-api.us-east-1.amazonaws.com
VITE_API_GATEWAY_URL=https://your-api-gateway-id.execute-api.us-east-1.amazonaws.com
VITE_AI_API_URL=http://localhost:8000
VITE_AWS_REGION=us-east-1
VITE_DEMO_USER_ID=

# ------------------------------------------
# AWS Cognito Authentication (PKCE Flow)
# ------------------------------------------
VITE_COGNITO_USER_POOL_ID=us-east-1_example
VITE_COGNITO_CLIENT_ID=exampleclientid1234567890
VITE_COGNITO_DOMAIN=https://your-domain.auth.us-east-1.amazoncognito.com
VITE_COGNITO_REDIRECT_URI=http://localhost:3000/login
VITE_COGNITO_REGION=us-east-1

# ------------------------------------------
# AWS DynamoDB Tables
# ------------------------------------------
DYNAMODB_CASES_TABLE=FitResQCases
DYNAMODB_ORDERS_TABLE=FitResQOrders
DYNAMODB_AUDIT_TABLE=FitResQAudit
DYNAMODB_SLA_TABLE=FitResQSLA

# ------------------------------------------
# AWS EventBridge & Messaging
# ------------------------------------------
EVENTBRIDGE_BUS_NAME=FitResQEvents
