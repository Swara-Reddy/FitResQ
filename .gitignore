# ==========================================
# FitResQ .gitignore
# ==========================================

# Environment variables & local secrets
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!frontend/.env.example

# Node / Frontend dependencies & logs
node_modules/
frontend/node_modules/
backend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Frontend build outputs
frontend/dist/
frontend/build/

# Python artifacts
__pycache__/
*.py[cod]
*.class
*.so
.Python
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
ENV/
env/

# IDEs & Editor configurations
.vscode/
.idea/
*.swp
*.swo

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# Scratch / Local test outputs & logs
scratch/
*.log
temp/
tmp/

# Explicitly ensure ML trained models and configuration templates are tracked
!backend/ml/models/*.joblib
!backend/ml/models/
